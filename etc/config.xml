<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <commercekings_notification>
            <infobip>
                <api_key backend_model="Magento\Config\Model\Config\Backend\Encrypted"/>
                <webhook_secret backend_model="Magento\Config\Model\Config\Backend\Encrypted"/>
                <optin_enabled>1</optin_enabled>
                <optin_text>{{store}}: you are signed up for messages. Message frequency varies; message and data rates may apply. Reply STOP to stop.</optin_text>
            </infobip>
        </commercekings_notification>
    </default>
</config>
